# Kopioi tämä tiedosto nimelle .env.local paikallista kehitystä varten.
# Vercelissä samat lisätään Project Settings -> Environment Variables.

# Supabase-projektin asetuksista (Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Julkinen (selaimeen päätyvä) Supabase-avain, eri kuin service role -avain yllä
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Satunnainen, itse keksitty salasana joka suojaa cron-reittejä ulkopuolisilta
# kutsuilta. Sama arvo pitää lisätä Vercelin Cron-asetuksiin (ks. README).
CRON_SECRET=keksi-tahan-pitka-satunnainen-merkkijono

# Kausi jota automaattinen haku koskee
NBA_SEASON=2026-27
